---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Asiste · Control de asistencia' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Aplicación para registrar y revisar la asistencia del curso." />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>
